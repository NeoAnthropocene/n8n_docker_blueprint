# PostgreSQL settings
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_strong_password_change_me
POSTGRES_DB=n8n

# n8n settings
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=generate_a_random_key_here

# Ngrok setup for webhooks (Optional but recommended for testing integrations)
# Run ngrok on your terminal: ngrok http 5678
# Then paste the https URL below:
# WEBHOOK_URL=https://<your-ngrok-id>.ngrok-free.app/
